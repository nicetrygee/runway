# Copy to .env and fill in. .env is gitignored.

# Required. The app fails to start without this.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional. Defaults to sqlite:///runway.db if unset.
# DATABASE_URL=sqlite:///runway.db

# Optional. Enables the "Quick add" AI feature on the Add Task page.
# Without it, quick-add flashes an error but the rest of the app works fine.
# ANTHROPIC_API_KEY=

# Optional. Set to 1 to have the Weekly Summary page (/summary) ask Claude
# for a short prose recap of tasks completed in the last 7 days, on top of
# the raw list. Off by default (even with ANTHROPIC_API_KEY set) — this is
# a real API call per page view, so it's opt-in.
# WEEKLY_SUMMARY_AI_ENABLED=0

# Optional. Set to 1 once the app is served over HTTPS to mark the session
# cookie Secure (browsers drop it silently over plain HTTP, so this stays
# off by default for local dev / HTTP-only deployments).
# SESSION_COOKIE_SECURE=0
