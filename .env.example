# Copy to .env and fill in. .env is gitignored.

# Required. The app fails to start without this.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional. Defaults to sqlite:///runway.db if unset.
# DATABASE_URL=sqlite:///runway.db

# Optional. Quick Add (AI) runs on a local model in LM Studio over its
# OpenAI-compatible API. Defaults shown; if LM Studio isn't running, quick-add
# flashes an error and the rest of the app works fine.
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=qwen3-8b

# Optional. Which LLM adapter to use: lmstudio (default, local) or anthropic
# (the Claude API, always hosted, so it only runs with RUNWAY_LAB=1 below).
# LLM_PROVIDER=lmstudio
# ANTHROPIC_MODEL=claude-sonnet-5-5
# The capped drift-run key (D1: its own workspace, prepaid, auto-reload off).
# Only ever used with RUNWAY_LAB=1 and synthetic data.
# ANTHROPIC_API_KEY=

# Optional. Lab mode. Calls to a hosted LLM (any LLM_BASE_URL whose host isn't
# localhost, 127.x.x.x or ::1) are blocked — and traced — unless this is 1.
# Only set it where ALL data is synthetic, never alongside real notes. The app
# logs a WARNING at startup when it's on.
# RUNWAY_LAB=0

# Optional. Every LLM call is traced to this separate SQLite file (gitignored).
# Defaults to traces.db in the repo root.
# TRACES_DB_PATH=traces.db

# Optional. Set to 1 to have the Weekly Summary (/summary) and Review (/review)
# pages ask the local model (LM Studio, as above) for a short prose recap of
# tasks completed in the last 7 days, on top of the raw list. Off by default —
# it's a model call that adds a few seconds to every page view, so it's opt-in.
# WEEKLY_SUMMARY_AI_ENABLED=0

# Optional. Set to 1 once the app is served over HTTPS to mark the session
# cookie Secure (browsers drop it silently over plain HTTP, so this stays
# off by default for local dev / HTTP-only deployments).
# SESSION_COOKIE_SECURE=0
